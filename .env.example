# TradeFlow - Stock Market Order Book Simulator Environment Configuration

# Backend Port (Default: 5050 to avoid macOS AirPlay conflict)
PORT=5050

# MongoDB URI (Optional: Leave blank or unset to auto-run embedded In-Memory MongoDB)
# Example for local MongoDB daemon: mongodb://127.0.0.1:27017/tradeflow
# Example for MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/tradeflow
MONGODB_URI=mongodb://127.0.0.1:27017/tradeflow

# Client / Frontend URL
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
